# ---------------------------------------------------------------------------
# LUXX PODS — variáveis de ambiente
# Copie para .env.local e preencha. Sem estas variáveis o painel roda
# com a base de demonstração (todas as telas funcionam, dados fictícios).
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# O Supabase renomeou as chaves: `anon` virou `publishable`, `service_role`
# virou `secret`. O sistema aceita os dois nomes — use o que o painel mostrar.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor. Esta chave ignora RLS: com o prefixo NEXT_PUBLIC_ ela iria
# para o navegador e qualquer pessoa leria o banco inteiro.
SUPABASE_SECRET_KEY=

# Loja padrão (o schema já é multiloja). Use o id criado pelo seed.
NEXT_PUBLIC_STORE_ID=22222222-2222-2222-2222-222222222222

# --------------------------- INTEGRAÇÕES (MVP 1) ---------------------------
# WhatsApp Business (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Instagram Direct (Meta) — MVP 2
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Gateway PIX
PIX_GATEWAY=
PIX_CLIENT_ID=
PIX_CLIENT_SECRET=
PIX_CHAVE=
PIX_WEBHOOK_SECRET=

# ------------------------------ ASAAS (opcional) ------------------------------
# O único que entrega as duas coisas: copia e cola de verdade no chat E
# confirmação automática por webhook. Usa QR Code estático com valor, que não
# exige o CPF do cliente — pedir documento no meio da conversa derruba venda.
#
# Preenchido, ele substitui o PIX estático e a baixa passa a ser automática.
ASAAS_API_KEY=
# "producao" aponta para api.asaas.com; qualquer outra coisa usa o sandbox.
# Deixe vazio enquanto estiver testando.
ASAAS_AMBIENTE=
# Chave PIX que recebe. Vazio: o sistema pergunta ao Asaas qual a conta tem.
ASAAS_PIX_KEY=
# Token que você cadastra no painel do Asaas ao criar o webhook.
# Sem ele o webhook aceita qualquer corpo — preencha antes de ir para produção.
ASAAS_WEBHOOK_TOKEN=

